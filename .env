NEXT_PUBLIC_CLUSTER=mainnet-beta

# Local development is similar as next public preview
NEXT_PUBLIC_IS_NEXT_PREVIEW=true

# =============================
# CONFIGURAÇÃO FLASK
# =============================
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=chave_super_secreta_troque_esta

# =============================
# CONFIGURAÇÃO JUPITER API
# =============================
# Endpoint público da Jupiter (já configurado no app)
JUPITER_API_URL=https://quote-api.jup.ag/v1/quote

# Caso futuramente queira fazer swaps reais, adicione:
# JUPITER_SWAP_URL=https://quote-api.jup.ag/v1/swap
# PHANTOM_SEED="palavras da seed da sua carteira Phantom aqui"  # NUNCA compartilhe publicamente

# =============================
# TELEGRAM BOT CONFIG
# =============================
# Bot: @Traidboltbot
TELEGRAM_BOT_TOKEN=coloque_o_token_aqui
TELEGRAM_CHAT_ID=coloque_o_chat_id_aqui

# =============================
# CONFIGURAÇÃO DO TRAIDBOLT
# =============================
# Porta local padrão do painel Flask
PORT=5000
# Host do painel (0.0.0.0 para Termux)
HOST=0.0.0.0

# =============================
# CONFIGURAÇÕES DE TRADE (OPCIONAL)
# =============================
# Variação mínima para comprar automaticamente (%)
AUTO_BUY_THRESHOLD=1.5
# Stop-loss padrão (%)
STOP_LOSS_PERCENT=20
# Reinvestimento automático de lucros
REINVEST_LUCROS=True

# =============================
# LOGS E HISTÓRICO
# =============================
LOG_FILE=logs/trades.log
DB_PATH=database/trades.db
